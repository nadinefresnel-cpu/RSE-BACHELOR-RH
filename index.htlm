<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Formation RSE - ESSENTIA35</title>
  <style>
    body {
      font-family: Calibri, sans-serif;
      background-color: #ffffff;
      color: #000000;
      margin: 0;
      padding: 0;
      font-size: 18px;
    }
    header {
      text-align: center;
      padding: 20px;
    }
    header h1 {
      font-size: 36px;
      color: #039BE5;
      margin-bottom: 10px;
    }
    header h2 {
      font-size: 24px;
      color: #039BE5;
      margin-top: 0;
    }
    .logo {
      display: block;
      margin: 0 auto 10px;
      max-width: 120px;
    }
    .separator {
      height: 4px;
      background-color: #039BE5;
      margin: 20px 0;
    }
    .accordion {
      width: 90%;
      margin: auto;
    }
    .accordion-item {
      border-bottom: 1px solid #039BE5;
      padding: 10px 0;
    }
    .accordion-item h3 {
      font-size: 24px;
      color: #039BE5;
      cursor: pointer;
    }
    .accordion-content {
      display: none;
      padding: 10px 0;
    }
    .downloads {
      text-align: center;
      margin: 30px 0;
    }
    .downloads a {
      background-color: #039BE5;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      margin: 10px;
      border-radius: 5px;
      display: inline-block;
    }
    .map {
      width: 100%;
      height: 300px;
      margin: 20px 0;
    }
    footer {
      background-color: #f5f5f5;
      padding: 20px;
      text-align: center;
      font-size: 16px;
    }
    footer a {
      color: #039BE5;
      text-decoration: none;
    }
  </style>
</head>
<body>

<header>
  <img src="logo-essentia35.png" alt="Logo ESSENTIA35" class="logo">
  <h1>RSE et Développement Durable</h1>
  <h2>Formation certifiante pour les métiers RH</h2>
</header>

<div class="separator"></div>

<section class="accordion">
  <div class="accordion-item">
    <h3 onclick="toggle(this)">Séance 1 : Fondamentaux RSE/DD</h3>
    <div class="accordion-content">Définitions, enjeux climatiques et anthropocène...</div>
  </div>
  <div class="accordion-item">
    <h3 onclick="toggle(this)">Séance 2 : RSE et fonction RH</h3>
    <div class="accordion-content">Diversité, inclusion, QVT, attractivité employeur...</div>
  </div>
  <!-- Autres séances ici -->
</section>

<div class="downloads">
  <a href="programme.pdf" download>📄 Télécharger le programme</a>
  <a href="livret-stagiaire.pdf" download>📘 Télécharger le livret stagiaire</a>
</div>

<iframe class="map"
  src="https://www.google.com/maps?q=44+rue+des+verdaudais+35690+Acigné&output=embed"
  frameborder="0"
  allowfullscreen>
</iframe>

<footer>
  <p>Contact : Nadine Fresnel – <a href="mailto:nadine.fresnel@essentia35.com">nadine.fresnel@essentia35.com</a></p>
  <p><a href="politique-inclusion.html">Politique d'inclusion et accessibilité</a></p>
</footer>

<script>
  function toggle(element) {
    const content = element.nextElementSibling;
    content.style.display = content.style.display === "block" ? "none" : "block";
  }
</script>

</body>
</html>
